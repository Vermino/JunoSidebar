<!-- File: JunoSidebar.Wpf\JunoSidebar.Wpf.csproj -->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>1.0.0</Version>
        <Authors>Juno Development Team</Authors>
        <Description>A modular, extensible AI assistant for Windows</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1901.177" />
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="System.Speech" Version="9.0.4" />
        <PackageReference Include="System.Text.Json" Version="8.0.6" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />

        <!-- LLM Providers -->
        <PackageReference Include="Anthropic.SDK" Version="0.3.0" />
        <PackageReference Include="OpenAI" Version="2.1.0" />

        <!-- Speech -->
        <PackageReference Include="Whisper.net" Version="1.7.4" />
        <PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />

        <!-- Tools -->
        <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
        <PackageReference Include="AngleSharp" Version="1.1.2" />

        <!-- Utilities -->
        <PackageReference Include="Polly" Version="8.4.2" />
        <PackageReference Include="Serilog" Version="4.1.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    </ItemGroup>

    <!-- Development-mode resources: copied to output directory -->
    <ItemGroup>
        <None Include="wwwroot\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Embedded resources for release mode -->
    <ItemGroup Condition="'$(Configuration)'=='Release'">
        <EmbeddedResource Include="wwwroot\**\*.*" />
    </ItemGroup>

    <!-- Create wwwroot directory if it doesn't exist -->
    <Target Name="EnsureWwwrootDirectory" BeforeTargets="PreBuildEvent">
        <MakeDir Directories="$(ProjectDir)wwwroot" Condition="!Exists('$(ProjectDir)wwwroot')" />
    </Target>

    <!-- Use BuildAndPackage.ps1 script for Release build 
        <Target Name="BuildReactUI" BeforeTargets="BeforeBuild" Condition="'$(Configuration)'=='Release'">
            <Exec Command="powershell -ExecutionPolicy Bypass -File $(SolutionDir)BuildAndPackage.ps1 -Configuration $(Configuration)" />
        </Target>
        -->
</Project>